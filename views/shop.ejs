<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop</title>
    <link rel="stylesheet" href="/stylesheets/theme.css" />
    <link rel="stylesheet" href="/stylesheets/shop.css" />
</head>

<body>
    <%- include('header') %>
    
    <div class="page-container">
        <div class="container">
        <% products.forEach(function(product) { %>
            <div class="card">
                <img src="/images/product/<%= product.pPhoto %>" alt="<%= product.pName %>" />
                <div class="card-body">
                    <h4 class="card-title">
                        <%= product.pName %>
                    </h4>
                    <i class="icon">&#9733;</i>
                </div>
                <div class="desc">
                    <p>
                        <%= product.pDescription %>
                    </p>
                </div>
                <div class="card-footer">
                    <p class="price">₹ <%= product.pPrice %>
                    </p>
                    <div class="quantity-section">
                        <div class="quantity-adjuster">
                            <button type="button" class="qty-btn qty-decrease" onclick="decreaseQty(this)">−</button>
                            <input type="number" class="qty-input" value="1" min="1" max="100">
                            <button type="button" class="qty-btn qty-increase" onclick="increaseQty(this)">+</button>
                        </div>
                        <button class="btn add-to-cart" onclick="addToCartAjax('<%= product._id %>', this)">ADD TO CART</button>
                    </div>
                </div>
                <form action="/bargain/<%= product._id %>" method="POST" class="bargain-form">
                    <div class="bargain-input-group">
                      <input
                        type="number"
                        name="proposedPrice"
                        placeholder="₹ Enter your offer"
                        required
                        min="1"
                        class="bargain-input"
                      />
                      <button type="submit" class="bargain-btn">Propose Price</button>
                    </div>
                  </form>
                  
            </div>

            <!-- Inside your product loop -->

            <% }); %>
        </div>
    </div>

    <div id="cart">
        <h3>Shopping Cart</h3>
        <ul id="cart-items"></ul>
        <div id="total-amount">Total: $0</div>
    </div>

    <script src="/javascripts/stripe-payment.js"></script>

    <script>
        // Quantity adjuster functions
        function increaseQty(btn) {
            const input = btn.previousElementSibling;
            input.value = Math.min(parseInt(input.value) + 1, 100);
        }

        function decreaseQty(btn) {
            const input = btn.nextElementSibling;
            input.value = Math.max(parseInt(input.value) - 1, 1);
        }

        // Add to cart with AJAX (no page reload)
        async function addToCartAjax(productID, btn) {
            const quantityInput = btn.parentElement.querySelector('.qty-input');
            const quantity = parseInt(quantityInput.value) || 1;

            try {
                const response = await fetch(`/addtocart/${productID}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ quantity: quantity })
                });

                const data = await response.json();
                
                if (data.success) {
                    // Show success message
                    showNotification(`✓ Added ${quantity} item${quantity > 1 ? 's' : ''} to cart!`, 'success');
                    
                    // Reset quantity to 1
                    quantityInput.value = 1;
                } else {
                    showNotification('Error adding to cart', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error adding to cart', 'error');
            }
        }

        // Notification function
        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);

            // Trigger animation
            setTimeout(() => notification.classList.add('show'), 10);

            // Remove after 3 seconds
            setTimeout(() => {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
    </script>
</body>

</html>